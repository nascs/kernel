        pinctrl-names = "default";
        pinctrl-0 = <&gpio_4_4_pins>;
        output-high;
    };

    usb2_0_ext {
        pinctrl-names = "default";
        pinctrl-0 = <&usb2_0_ext_pins>;
        output-high;
    };
};

&gpio3 {
    usb2_0 {
