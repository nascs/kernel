&pinctrl {
		sdio-pwrseq {
		wifi_enable_h: wifi-enable-h {
			rockchip,pins = < 4 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none >;
		};
	};
};

&pinctrl {
		wireless-wlan {
		wifi_host_wake_irq: wifi-host-wake-irq {
			rockchip,pins = < 0 RK_PD4 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};
};


&sdmmc {
	max-frequency = <150000000>;
	no-sd;
	no-mmc;
	bus-width = <4>;
	cap-sdio-irq;
	disable-wp;
	non-removable;
	mmc-pwrseq = <&sdio_pwrseq>;
	// cap-sd-highspeed;
	// sd-uhs-sdr104;
	// vmmc-supply = <&vcc_3v3_s3>;
	// vqmmc-supply = <&vccio_sd_s0>;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc_bus4 &sdmmc_clk &sdmmc_cmd>;
	status = "okay";
};


&pinctrl {
    fan_pins {
        fan1_pins: fan1-pins {
            rockchip,pins = <1 RK_PB6 RK_FUNC_GPIO &pcfg_pull_up>;  // GPIO1_B6_u，默认拉高
        };

        fan2_pins: fan2-pins {
            rockchip,pins = <1 RK_PB7 RK_FUNC_GPIO &pcfg_pull_up>;  // GPIO1_B7_u，默认拉高
        };
    };

    gpio_pins {
        gpio_4_1_pins: gpio-4-1-pins {
            rockchip,pins = <1 RK_PC6 RK_FUNC_GPIO &pcfg_pull_up>;  // GPIO1_C6_d，默认拉高
        };

        gpio_4_2_pins: gpio-4-2-pins {
            rockchip,pins = <1 RK_PD5 RK_FUNC_GPIO &pcfg_pull_up>;  // GPIO1_D5_d，默认拉高
        };

        gpio_4_3_pins: gpio-4-3-pins {
            rockchip,pins = <1 RK_PC4 RK_FUNC_GPIO &pcfg_pull_up>;  // GPIO1_C4_d，默认拉高
        };

        gpio_4_4_pins: gpio-4-4-pins {
            rockchip,pins = <0 RK_PC2 RK_FUNC_GPIO &pcfg_pull_up>;  // GPIO0_C2_D，默认拉高
        };
    };

    usb_pins {
        usb2_0_ext_pins: usb2-0-ext-pins {
            rockchip,pins = <0 RK_PD3 RK_FUNC_GPIO &pcfg_pull_up>;  // GPIO0_D3_u，USB2.0 对外，默认拉高
        };

        usb2_0_pins: usb2-0-pins {
            rockchip,pins = <3 RK_PC0 RK_FUNC_GPIO &pcfg_pull_up>;  // GPIO3_C0_d，USB2.0 对外，默认拉高
        };
    };

    motor_pins {
        motor_vibration_pins: motor-vibration-pins {
            rockchip,pins = <3 RK_PB7 RK_FUNC_GPIO &pcfg_pull_up>;  // GPIO3_B7_d，震动马达，默认拉高
        };
    };

    power_pins {
        internal_power_pins: internal-power-pins {
            rockchip,pins = <4 RK_PA4 RK_FUNC_GPIO &pcfg_pull_up>;  // GPIO4_A4_d，内部模块供电，默认拉高
        };

        usb2_0_hub_pins: usb2-0-hub-pins {
            rockchip,pins = <4 RK_PA7 RK_FUNC_GPIO &pcfg_pull_up>;  // GPIO4_A7，USB2.0 HUB，默认拉高
        };
    };
};


&gpio1 {
    fan1 {
        pinctrl-names = "default";
        pinctrl-0 = <&fan1_pins>;
        output-high;
    };

    fan2 {
        pinctrl-names = "default";
        pinctrl-0 = <&fan2_pins>;
        output-high;
    };

    gpio_4_1 {
        pinctrl-names = "default";
